# Copy to .env and customize for this machine. .env is excluded from Git.
# The application still listens on port 8080 inside the container.
MONITOR_BIND=127.0.0.1
MONITOR_PORT=8080

# Optional first-run admin password (10–256 characters). Blank generates one.
# Only used when there are no accounts; changing this does not reset existing users.
MONITOR_ADMIN_PASSWORD=
# Set true only when the dashboard is served over HTTPS.
MONITOR_SECURE_COOKIE=false
